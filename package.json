{
  "name": "mpm-digital",
  "version": "1.0.0",
  "private": true,
  "description": "MPM Digital: household products store for home shoppers and wholesale buyers",
  "main": "server/app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js store",
    "admin": "node --env-file-if-exists=.env server/server.js admin",
    "dev:store": "node --watch --env-file-if-exists=.env server/server.js store",
    "dev:admin": "node --watch --env-file-if-exists=.env server/server.js admin",
    "build": "node scripts/build.js",
    "import-catalog": "node --env-file-if-exists=.env scripts/import-catalog.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.9.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
