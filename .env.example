# Copy to .env and fill in. Never commit .env.
PORT=3000

# First admin account (created on start if no admin exists). Password: 10+ characters.
ADMIN_EMAIL=you@yourdomain.co.za
ADMIN_PASSWORD=change-me-to-something-long

# Shown to shoppers who choose EFT
STORE_EMAIL=orders@yourdomain.co.za
BANK_NAME=
BANK_ACCOUNT_NAME=MPM Digital
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=

# Set to 1 when the site runs on https (adds the Secure flag to login cookies)
COOKIE_SECURE=0

# Payment connectors (leave empty until connected; see server/payments.js)
CARD_GATEWAY=
INSTANT_EFT_GATEWAY=
