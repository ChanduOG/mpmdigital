# Copy to .env for local development. Never commit .env.
# Locally:  npm start  -> shop on :3000      npm run admin  -> back office on :3001
PORT=3000
ADMIN_PORT=3001

# First admin account (created if no admin exists). Password: 10+ characters.
ADMIN_EMAIL=you@yourdomain.co.za
ADMIN_PASSWORD=change-me-to-something-long

# The shop's address (shown as "View shop" in the back office)
STORE_URL=http://localhost:3000

# Defaults until you set them in Back office -> Settings
STORE_EMAIL=orders@yourdomain.co.za
BANK_NAME=
BANK_ACCOUNT_NAME=MPM Digital
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=

# Set to 1 when running on https outside Vercel (adds the Secure flag to login cookies)
COOKIE_SECURE=0

# Hosted database (set automatically on Vercel by the Turso integration)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Payment connectors (leave empty until connected; see server/payments.js)
CARD_GATEWAY=
INSTANT_EFT_GATEWAY=
